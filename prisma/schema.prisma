generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STORE_MANAGER
  MODERATOR
  CUSTOMER
}

enum OrderStatus {
  PENDING // awaiting admin confirmation
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// How the customer sent the order request to the store
enum OrderChannel {
  WHATSAPP
  EMAIL
  WEB // reserved for Bangla QR / online payment
}

enum PaymentMethod {
  COD
  BANGLA_QR // future
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DeliveryZone {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String? // normalized +8801XXXXXXXXX
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  cart      Cart?
  wishlist  Wishlist?
  addresses Address[]
  reviews   Review[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String   @db.Text
  price           Decimal  @db.Decimal(12, 2) // BDT
  comparePrice    Decimal? @db.Decimal(12, 2) // BDT
  images          String[]
  stock           Int      @default(0)
  isFeatured      Boolean  @default(false)
  isArchived      Boolean  @default(false)
  // Denormalized for filtering/sorting; kept in sync by product + review + order actions
  discountPercent Int      @default(0)
  ratingAvg       Float    @default(0)
  ratingCount     Int      @default(0)
  soldCount       Int      @default(0)
  categoryId      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]

  @@index([categoryId])
  @@index([slug])
  @@index([isArchived, price])
  @@index([isArchived, createdAt])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String
  status        OrderStatus   @default(PENDING)
  channel       OrderChannel  @default(WHATSAPP)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentRef    String?       @unique // Bangla QR transaction id (future)

  subtotal    Decimal @db.Decimal(12, 2)
  deliveryFee Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  customerName  String
  customerPhone String
  customerEmail String?
  address       String
  district      String
  deliveryZone  DeliveryZone
  note          String?

  confirmedAt   DateTime?
  confirmedById String?
  cancelledAt   DateTime?
  adminNote     String?

  shippingAddress Json? // legacy
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  name      String  @default("") // snapshot at order time

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Wishlist {
  id     String @id @default(cuid())
  userId String @unique

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String @id @default(cuid())
  wishlistId String
  productId  String

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([wishlistId, productId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String?
  street     String
  city       String
  state      String
  postalCode String
  country    String
  isDefault  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// Single-row store configuration editable from /admin/settings
model StoreSettings {
  id                 String   @id @default("default")
  whatsappNumber     String   @default("+8801999398675")
  orderEmail         String?
  deliveryFeeInside  Int      @default(60)
  deliveryFeeOutside Int      @default(120)
  updatedAt          DateTime @updatedAt
}

// Fixed-window rate limiting that works across serverless instances
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
