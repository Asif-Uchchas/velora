# Copy to .env.local for local development. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Postgres (Neon / Supabase / RDS). Use the pooled URL on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Optional GitHub sign-in
GITHUB_ID=""
GITHUB_SECRET=""

# "Order by email" (Gmail SMTP). Use a Google App Password, not the account password:
# Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER="yourstore@gmail.com"
GMAIL_APP_PASSWORD=""
# Where email orders go if no "Order email" is set in /admin/settings (defaults to GMAIL_USER)
ORDER_NOTIFY_EMAIL=""
